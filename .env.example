# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Comma-separated Supabase Auth emails allowed into /admin.
ADMIN_EMAILS=you@example.com

# Secret code she messages you to get for her 1 Lucky Draw ticket (defaults to WISHFORYOU if unset).
LUCKY_DRAW_CODE=WISHFORYOU
